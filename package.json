{
  "name": "ai-git-assistant",
  "displayName": "AI Git Assistant",
  "description": "A minimal foundation for an AI-powered Git assistant in VS Code",
  "version": "0.0.1",
  "publisher": "ai-git-assistant",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiGitAssistant",
          "title": "AI Git Assistant",
          "icon": "resources/ai-git-assistant.svg"
        }
      ]
    },
    "views": {
      "aiGitAssistant": [
        {
          "id": "aiGitAssistant.overview",
          "name": "AI Git Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-git-assistant.helloWorld",
        "title": "AI Git Assistant: Hello World"
      },
      {
        "command": "aiGitAssistant.openChanges",
        "title": "AI Git Assistant: Open Git Changes"
      },
      {
        "command": "aiGitAssistant.refreshChanges",
        "title": "AI Git Assistant: Refresh Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "aiGitAssistant.openDiff",
        "title": "AI Git Assistant: Open Diff"
      },
      {
        "command": "ai-git-assistant.getWorkspaceInfo",
        "title": "AI Git Assistant: Check WorkspaceInfo"
      },
      {
        "command": "ai-git-assistant.checkGitRepository",
        "title": "AI Git Assistant: Check Git Repository"
      },
      {
        "command": "aiGitAssistant.ai.setApiKey",
        "title": "Set Gemini API Key",
        "category": "AI Git Assistant",
        "icon": "$(key)"
      },
      {
        "command": "aiGitAssistant.ai.clearApiKey",
        "title": "Remove Gemini API Key",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.testConnection",
        "title": "Test AI Connection",
        "category": "AI Git Assistant",
        "icon": "$(plug)"
      },
      {
        "command": "aiGitAssistant.ai.selectModel",
        "title": "Select AI Model",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.generateCommitMessage",
        "title": "Generate Commit Message with AI",
        "category": "AI Git Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiGitAssistant.ai.explainChanges",
        "title": "AI: Explain Changes",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.explainStagedChanges",
        "title": "AI: Explain Staged Changes",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.reviewChanges",
        "title": "AI: Review Changes",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.openChat",
        "title": "AI: Open Git Chat",
        "category": "AI Git Assistant",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiGitAssistant.ai.summarizeHistory",
        "title": "AI: Summarize Commit History",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.summarizeBranch",
        "title": "AI: Summarize Current Branch",
        "category": "AI Git Assistant"
      },
      {
        "command": "aiGitAssistant.ai.resolveConflict",
        "title": "AI: Suggest Merge Conflict Resolution",
        "category": "AI Git Assistant"
      }
    ],
    "configuration": {
      "title": "AI Git Assistant",
      "properties": {
        "aiGitAssistant.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI features in AI Git Assistant."
        },
        "aiGitAssistant.ai.provider": {
          "type": "string",
          "enum": [
            "gemini"
          ],
          "enumDescriptions": [
            "Google Gemini (REST API)"
          ],
          "default": "gemini",
          "description": "AI provider. The API key is stored in VS Code SecretStorage (command: \"Set Gemini API Key\")."
        },
        "aiGitAssistant.ai.model": {
          "type": "string",
          "default": "gemini-flash-latest",
          "markdownDescription": "Gemini model id, e.g. `gemini-flash-latest`, `gemini-2.5-flash`, `gemini-2.5-pro`. Use the **Select AI Model** command to pick from the models available to your key."
        },
        "aiGitAssistant.ai.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "description": "Maximum time to wait for an AI response."
        },
        "aiGitAssistant.ai.responseLanguage": {
          "type": "string",
          "default": "Vietnamese",
          "enum": [
            "Vietnamese",
            "English"
          ],
          "description": "Language for explanations, code reviews, chat answers and summaries."
        },
        "aiGitAssistant.ai.commitMessageLanguage": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "Vietnamese"
          ],
          "description": "Language of generated commit messages."
        },
        "aiGitAssistant.ai.commitMessageStyle": {
          "type": "string",
          "default": "conventional",
          "enum": [
            "conventional",
            "simple"
          ],
          "enumDescriptions": [
            "Conventional Commits: feat(scope): subject",
            "Plain summary line without a type prefix"
          ],
          "description": "Format of generated commit messages."
        },
        "aiGitAssistant.ai.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 2000,
          "maximum": 500000,
          "description": "Maximum number of diff characters sent to the AI. Larger diffs are truncated fairly across files."
        },
        "aiGitAssistant.ai.excludeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "composer.lock",
            "Cargo.lock",
            "poetry.lock",
            "Gemfile.lock",
            "go.sum",
            "*.min.js",
            "*.min.css",
            "*.map",
            "dist/**",
            "out/**",
            "build/**",
            "node_modules/**"
          ],
          "description": "Glob patterns of generated/lock files whose diff content is not sent to the AI (only a one-line note)."
        },
        "aiGitAssistant.ai.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask API keys, tokens, passwords and private keys in diffs before sending them to the AI. Sensitive files (.env, *.pem, *.key, ...) are never sent."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "aiGitAssistant.ai.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aiGitAssistant.ai.generateCommitMessage",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "node scripts/run-unit-tests.js",
    "test": "npm run check-types && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
