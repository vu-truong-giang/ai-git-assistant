{
  "name": "ai-git-assistant",
  "displayName": "AI Git Assistant",
  "description": "A minimal foundation for an AI-powered Git assistant in VS Code",
  "version": "0.0.1",
  "publisher": "ai-git-assistant",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-git-assistant.helloWorld",
        "title": "AI Git Assistant: Hello World"
      },
      {
        "command": "aiGitAssistant.refreshChanges",
        "title": "Refresh Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "aiGitAssistant.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "ai-git-assistant.getWorkspaceInfo",
        "title": "AI Git Assistant: Check WorkspaceInfo"
      }
    ],
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "aiGitAssistantChanges",
          "name": "AI Git Changes Context",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiGitAssistant.refreshChanges",
          "when": "view == aiGitAssistantChanges",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AI Git Assistant",
      "properties": {
        "aiGitAssistant.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI features in AI Git Assistant."
        },
        "aiGitAssistant.ai.model": {
          "type": "string",
          "default": "gpt-5.6",
          "description": "AI model used by AI Git Assistant."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
